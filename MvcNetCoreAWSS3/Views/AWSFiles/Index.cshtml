@model List<string>

@{
    string bucketUrl = configuration.GetValue<string>("AWS:BucketUrl");
}

<div class="container mt-5">
    <div class="card shadow p-4">
        <h1 class="text-primary mb-4">📦 AWS Storage S3</h1>

        <div class="mb-3">
            <a asp-controller="AWSFiles"
               asp-action="UploadFile"
               class="btn btn-success">
                📤 Upload New File
            </a>
        </div>

        @if (Model != null && Model.Count > 0)
        {
            <ul class="list-group">
                @foreach (string name in Model)
                {
                    <li class="list-group-item d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center">
                            <img src="@bucketUrl@name"
                                 class="me-3 rounded"
                                 style="width: 100px; height: 100px; object-fit: cover;" />
                            <span class="fw-bold">@name</span>
                        </div>

                        <div class="d-flex gap-2">
                            <a asp-controller="AWSFiles"
                               asp-action="PrivateFile"
                               asp-route-filename="@name"
                               class="btn btn-outline-warning btn-sm">
                                🔒 Private File
                            </a>
                            <a asp-controller="AWSFiles"
                               asp-action="DeleteFile"
                               asp-route-filename="@name"
                               class="btn btn-outline-danger btn-sm">
                                🗑 Delete
                            </a>
                        </div>
                    </li>
                }
            </ul>
        }
    </div>
</div>
